# Medora — Root Environment Configuration Template
PORT=5000
SECRET_KEY=replace-with-a-secure-random-secret-key-for-jwt-signing
FRONTEND_URL=http://localhost:5173
DATABASE_PATH=medora.db

# Optional Supabase Connection (Leave empty for built-in SQLite engine)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=

# Production Rate Limiting (Redis URL, or memory:// for local dev)
REDIS_URL=memory://

# Optional Public Base URL for Emergency QR Links (e.g. deployed cloud domain)
# In local Public Testing Mode, this is automatically discovered from ngrok.
# EMERGENCY_BASE_URL=https://your-production-app.com

# ==============================================================================
# TRANSACTIONAL EMAIL INFRASTRUCTURE (Server-Side Developer Settings)
# ==============================================================================
# Option A: Brevo (Recommended transactional email API)
BREVO_API_KEY=
EMAIL_FROM=Medora Alerts <alerts@yourdomain.com>

# Option B: Resend (https://resend.com)
RESEND_API_KEY=

# Option C: SendGrid (https://sendgrid.com)
SENDGRID_API_KEY=

# Option D: Standard SMTP Fallback
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=alerts@medora.app
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT=10

# ngrok Public Testing (Optional: personal authtoken for cross-device mobile scanning)
NGROK_AUTHTOKEN=
