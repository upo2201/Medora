# Medical Snapshot QR — Backend Environment Configuration
PORT=5000
SECRET_KEY=replace-with-a-secure-random-secret-key-for-jwt-signing
FRONTEND_URL=http://localhost:5173
DATABASE_PATH=medora.db

# Optional Supabase Production Connection (Leave empty for built-in SQLite engine)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# Production Rate Limiting (Redis URL, or memory:// for local dev)
REDIS_URL=memory://

# Simulated Notification Cooldown (Seconds between scan alerts for same profile)
NOTIFICATION_COOLDOWN_SECONDS=30

# ==============================================================================
# PERMANENT TRANSACTIONAL EMAIL INFRASTRUCTURE (Server-Side Developer Settings)
# ==============================================================================
# The application owner / developer configures one of these providers ONCE.
# Ordinary Medora users never configure SMTP or supply email credentials.
#
# Option A: Resend (Recommended modern transactional email - https://resend.com)
# 1. Sign up at https://resend.com and generate an API key (e.g. re_123456789)
# 2. Add your verified domain (or use onboarding@resend.dev during testing)
# RESEND_API_KEY=re_your_resend_api_key
# EMAIL_FROM=Medora Alerts <onboarding@resend.dev>  # (or <alerts@yourverifieddomain.com>)
RESEND_API_KEY=
EMAIL_FROM=Medora Alerts <onboarding@resend.dev>

# Option B: Brevo (formerly Sendinblue - https://brevo.com)
# 1. Sign up at https://brevo.com and obtain your API v3 key
# BREVO_API_KEY=xkeysib-your_brevo_api_key
BREVO_API_KEY=

# Option C: SendGrid (https://sendgrid.com)
# 1. Sign up at https://sendgrid.com and create an API key with Mail Send permissions
# SENDGRID_API_KEY=SG.your_sendgrid_key
SENDGRID_API_KEY=

# Option D: Standard SMTP Fallback (Optional self-hosted / enterprise mail server)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=alerts@medora.app
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT=10

# ngrok Public Testing (Auto-configured when running start_public_mode)
NGROK_AUTHTOKEN=

